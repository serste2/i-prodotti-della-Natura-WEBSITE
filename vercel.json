      "destination": "/index.html"
    },
    {
      "source": "/de",
      "destination": "/index.html"
    },
    {
      "source": "/de/",
      "destination": "/index.html"
    },
    {
      "source": "/fr",
      "destination": "/index.html"
    },
    {
      "source": "/fr/",
      "destination": "/index.html"
    },
    {
      "source": "/hi",
      "destination": "/index.html"
    },
    {
      "source": "/hi/",
      "destination": "/index.html"
    },
    {
      "source": "/es",
      "destination": "/index.html"
    },
    {
      "source": "/es/",
      "destination": "/index.html"
    }
  ]
